{
  "name": "routerflip",
  "version": "1.0.0",
  "description": "RouterFlip — switch your Claude Code gateway in seconds.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "router",
    "gateway",
    "cli",
    "proxy",
    "api-key"
  ],
  "license": "MIT",
  "author": "Tejas Mali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejasmmali/RouterFlip.git"
  },
  "homepage": "https://github.com/tejasmmali/RouterFlip#readme",
  "bugs": {
    "url": "https://github.com/tejasmmali/RouterFlip/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "routerflip": "bin/routerflip.js",
    "rflip": "bin/routerflip.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run test",
    "start": "node --experimental-strip-types src/cli.ts",
    "prepublishOnly": "npm run check && npm run clean && npm run build"
  },
  "dependencies": {
    "routerflip": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
